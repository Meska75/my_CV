# Copy this file to .env and fill in real values. Never commit the real .env.
# On the host, DEBUG must be False and ALLOWED_HOSTS must be this site's
# own domain. The other site keeps its own domain and its own app folder.
SECRET_KEY=change-me-generate-with-get_random_secret_key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Required when DEBUG=False. Scheme + domain of THIS site, comma-separated.
# CSRF_TRUSTED_ORIGINS=https://cv.example.com,https://www.cv.example.com

# Web server already redirects HTTP to HTTPS and sets X-Forwarded-Proto.
# Set False only if that header is missing and the browser redirect-loops.
# SECURE_SSL_REDIRECT=True

# Stay at 0 until https:// opens correctly, then you may set 31536000.
# SECURE_HSTS_SECONDS=0

# Leave empty. This site should have its own domain, not a subfolder of the
# other site. A path such as /cv is a last resort and needs a matching proxy.
# FORCE_SCRIPT_NAME=

# True only if this domain's traffic passes through Cloudflare.
TRUST_CLOUDFLARE=False

# Hidden admin URL (must end with a slash). Pick your own secret path.
ADMIN_URL=admin/

# Gmail SMTP for admin password recovery (use a Google App Password, not your login password).
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=you@gmail.com

# Optional: lock the account after this many failed logins.
AXES_FAILURE_LIMIT=5

# sqlite on your computer. On the server set postgresql and install
# PostgreSQL on that same host.
DB_ENGINE=sqlite

# Used only when DB_ENGINE=postgresql.
# DB_NAME=task5_cv
# DB_USER=task5_cv
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
