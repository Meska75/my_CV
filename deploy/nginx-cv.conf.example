# Name-based virtual host for THIS site only.
# Leave the other site's server block untouched.
# Replace cv.example.com and the filesystem paths, then:
#   sudo nginx -t && sudo systemctl reload nginx
#
# Gunicorn for this app listens on 127.0.0.1:8015 (see cv.service.example)
# so it does not take the port the other site already uses.

server {
    listen 80;
    listen [::]:80;
    server_name cv.example.com www.cv.example.com;
    return 301 https://cv.example.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.cv.example.com;
    ssl_certificate     /etc/letsencrypt/live/cv.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cv.example.com/privkey.pem;
    return 301 https://cv.example.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name cv.example.com;

    ssl_certificate     /etc/letsencrypt/live/cv.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cv.example.com/privkey.pem;

    client_max_body_size 20M;

    location /static/ {
        alias /var/www/task5_cv/staticfiles/;
        access_log off;
        expires 30d;
    }

    location /media/ {
        alias /var/www/task5_cv/media/;
        access_log off;
        expires 7d;
    }

    location / {
        proxy_pass http://127.0.0.1:8015;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
