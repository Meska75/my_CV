            { "id": "r2", "name": "rule_snippet", "value": "اگر اسنیپت دست رقیب است: یک FAQ کوتاه برای همان پرسش", "type": "string" },
            { "id": "r3", "name": "rule_local", "value": "اگر برند در بسته محلی نیست: تکمیل گوگل بیزینس و نظرات", "type": "string" }
