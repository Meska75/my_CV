    {
      "id": "serp",
      "name": "Bright Data — نتایج گوگل",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.brightdata.com/request",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"zone\": \"serp_api\",\n  \"format\": \"raw\",\n  \"country\": \"ir\",\n  \"url\": \"https://www.google.com/search?q={{ encodeURIComponent($json.keyword) }}&hl=fa&gl=ir&num=10\"\n}",
        "options": {}
      },
      "credentials": { "httpHeaderAuth": { "id": "bd-demo", "name": "Bright Data" } }
    },
    {
      "id": "normalize",
      "name": "نرمال رتبه و سهم صدا",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1060, 300],
      "parameters": {
        "jsCode": "const brand = 'aria-clinic.ir';\nconst rows = $input.all().map(i => i.json);\nconst top = rows.flatMap(r => (r.organic || []).slice(0, 10));\nconst owned = top.filter(r => String(r.link || '').includes(brand)).length;\nconst share = top.length ? Math.round((owned / top.length) * 100) : 0;\nreturn [{\n  json: {\n    keyword: rows[0]?.keyword || 'کلینیک قلب تهران',\n    our_rank: (rows[0]?.organic || []).findIndex(r => String(r.link || '').includes(brand)) + 1,\n    share_of_voice: share,\n    snippet_owner: rows[0]?.organic?.[0]?.domain || 'رقیب',\n    sample: 'رتبه برند در کلمه هدف و سهم نتایج ده تای اول'\n  }\n}];"
      }
    },
    {
      "id": "sheet-history",
      "name": "سابقه هفته قبل",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
