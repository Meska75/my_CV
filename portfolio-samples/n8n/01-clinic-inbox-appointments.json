    {
      "id": "match-slot",
      "name": "تطبیق با تقویم",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 460],
      "parameters": {
        "jsCode": "const cal = $('تقویم بیمارستان').item.json.calendar;\nconst want = $json.requested_slot;\nconst free = cal.slots.includes(want) && !cal.booked.includes(want);\nconst next = cal.slots.find(s => !cal.booked.includes(s));\nreturn [{ json: { ...$json, slot_free: free, alternative_slot: next } }];"
      }
    },
