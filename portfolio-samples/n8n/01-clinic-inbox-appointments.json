    {
      "id": "calendar",
      "name": "تقویم بیمارستان",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 280],
      "notes": "فقط پرسنل بیمارستان این آبجکت را ویرایش می‌کند.",
      "notesInFlow": true,
      "parameters": {
        "jsCode": "// بیمارستان: ساعات، روزها، نوبت‌های آزاد و رزروشده\nconst calendar = {\n  timezone: 'Asia/Tehran',\n  days: 'شنبه تا چهارشنبه',\n  hours: '09:00-13:00 و 16:00-20:00',\n  visitMinutes: 30,\n  slots: ['2026-10-18 09:30', '2026-10-18 11:00', '2026-10-19 16:00', '2026-10-19 16:30', '2026-10-20 10:00'],\n  booked: ['2026-10-18 09:00', '2026-10-18 10:00']\n};\nconst email = $input.first().json;\nreturn [{ json: { ...email, calendar } }];"
      }
    },
    {
      "id": "ai-classify",
      "name": "تحلیل ایمیل",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [760, 280],
      "parameters": {
        "modelId": { "__rl": true, "value": "gpt-4o-mini", "mode": "list", "cachedResultName": "gpt-4o-mini" },
        "messages": {
          "values": [
            { "role": "system", "content": "فقط JSON بده: intent یکی از open_slot | fixed_slot | unclear. اگر ساعت خواسته شده requested_slot را به شکل YYYY-MM-DD HH:mm بده وگرنه null. یک summary فارسی هم بده." },
            { "content": "={{ $json.text || $json.snippet || $json.subject }}" }
          ]
        },
        "jsonOutput": true,
        "simplifyOutput": true
      },
      "credentials": { "openAiApi": { "id": "openai-demo", "name": "OpenAI" } }
    },
    {
      "id": "switch-intent",
      "name": "نوع درخواست",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1020, 280],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "open_slot", "operator": { "type": "string", "operation": "equals" } }]
              }
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "fixed_slot", "operator": { "type": "string", "operation": "equals" } }]
              }
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      }
    },
    {
      "id": "nearest",
      "name": "نزدیک‌ترین نوبت",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 120],
      "parameters": {
        "jsCode": "const cal = $('تقویم بیمارستان').item.json.calendar;\nconst slot = cal.slots.find(s => !cal.booked.includes(s));\nreturn [{ json: { ...$json, offered_slot: slot } }];"
      }
    },
